generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  password  String?
  createdAt DateTime  @default(now())
  theme     String?   @default("light")
  trueName  String?
  bio       String?   @default("New account")
  avatarUrl String?
  city         String?
  latitude     Float?
  longitude    Float?


  events    Event[]   @relation("CreatedEvents")
  attending Event[]   @relation("EventAttendees")

  ownedChannels      Channel[]       @relation("ChannelOwner")
  channelMemberships ChannelMember[]
  messages           Message[]
  reactions          Reaction[]
  pollVotes          PollVote[]
  bannedFrom         ChannelBan[]
}

model Event {
  id           Int       @id @default(autoincrement())
  title        String
  description  String
  address      String?
  neighborhood String?
  city         String?
  latitude     Float
  longitude    Float
  eventDate    DateTime
  maxAttendees Int?
  creatorId    String
  creator      User      @relation("CreatedEvents", fields: [creatorId], references: [id])
  attendees    User[]    @relation("EventAttendees")
  tags         Tag[]     @relation("EventTags")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([eventDate])
  @@index([latitude, longitude])
}

model Tag {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  events Event[] @relation("EventTags")
}

// ===== CHANNEL MODELS =====

model Channel {
  id          String    @id @default(uuid())
  ownerId     String
  title       String
  description String?
  isPublic    Boolean   @default(true)
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner    User            @relation("ChannelOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  ChannelMember[]
  messages Message[]
  bans     ChannelBan[]

  @@index([ownerId])
  @@index([isPublic])
}

enum ChannelRole {
  OWNER
  MODERATOR
  FOLLOWER
}

model ChannelMember {
  channelId String
  userId    String
  role      ChannelRole @default(FOLLOWER)
  joinedAt  DateTime    @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

enum MessageType {
  TEXT
  IMAGE
  POLL
  ANNOUNCEMENT
  VIDEO
}

model Message {
  id        String      @id @default(uuid())
  channelId String
  authorId  String
  type      MessageType
  content   Json        // { text?, imageUrl?, poll?: { question, options: [{id, text}] } }
  createdAt DateTime    @default(now())

  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions Reaction[]
  pollVotes PollVote[]

  @@index([channelId, createdAt])
  @@index([authorId])
}

model Reaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([messageId])
}

model PollVote {
  messageId String
  userId    String
  optionId  String   // ID opcji z content.poll.options
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([messageId])
}

model ChannelBan {
  channelId String
  userId    String
  reason    String?
  until     DateTime? // null = permanent
  createdAt DateTime  @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}